<clickhouse>
    <!-- Each server's own `cas_server_root_id` (the prefix of its in-memory namespaces and of its S3 staging
         subtree), a per-instance override merged onto the shared storage_conf.xml disk definition. -->
    <storage_configuration>
        <disks>
            <disk_cas_shared>
                <cas_server_root_id>node2</cas_server_root_id>
            </disk_cas_shared>
        </disks>
    </storage_configuration>
</clickhouse>
